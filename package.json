{
  "name": "hashi",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@12.23.0",
  "author": "Ray <i@mk1.io> (https://github.com/so1ve/)",
  "type": "module",
  "description": "Two-way Telegram contact relay bot for Cloudflare Workers and Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/so1ve/hashi.git"
  },
  "license": "MIT",
  "engines": {
    "node": "^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "wrangler dev",
    "lint": "eslint . && prettier . --check",
    "lint:fix": "eslint . --fix && prettier . --write",
    "release": "bumpp",
    "setup": "node src/cli/setup.ts",
    "start": "node src/entry/node.ts",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.21"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "latest",
    "@so1ve/eslint-config": "^4.7.0",
    "@so1ve/prettier-config": "^4.7.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
